VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Optional while editing locally:
# local = use browser storage, no Supabase calls
# cloud = force local dev server to use Supabase
# VITE_DATA_MODE=local
# VITE_DATA_MODE=cloud
# Development defaults to local preview. Production requires cloud credentials.
# Never use VITE_DEMO_MODE=true for the live production website.
